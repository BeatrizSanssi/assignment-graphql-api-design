			"name": "registerUser (Success)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", () => {",
							"    pm.response.to.have.status(200);",
							"});",
							"const jsonData = pm.response.json();",
							"pm.test(\"No errors returned\", () => {",
							"    pm.expect(jsonData.errors).to.be.undefined;",
							"});",
							"pm.test(\"User object returned with correct email\", () => {",
							"    pm.expect(jsonData.data.registerUser).to.be.an(\"object\");",
							"    pm.expect(jsonData.data.registerUser.email).to.eql(pm.environment.get(\"randomEmail\"));",
							"});",
							"",
							"// Save email and password for future use in environment variables.",
							"const email = pm.environment.get(\"randomEmail\");",
							"const password = pm.environment.get(\"randomPassword\");",
							"pm.environment.set(\"savedEmail\", email);",
							"pm.environment.set(\"savedPassword\", password);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"query\": \"mutation { registerUser(email: \\\"{{randomEmail}}\\\", password: \\\"{{randomPassword}}\\\") { id email } }\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
